{
  "expo": {
    "name": "CoreOS",
    "slug": "CoreOS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coreos",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.coreos.zettelkasten",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "CoreOS necesita acceso al micrófono para capturar notas de voz.",
        "NSSpeechRecognitionUsageDescription": "CoreOS utiliza el reconocimiento de voz para transcribir tus notas en el dispositivo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F2EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.coreos.zettelkasten"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F2EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 152
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1
            }
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "CoreOS necesita acceso al micrófono para capturar notas de voz."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "CoreOS necesita acceso al micrófono para capturar notas de voz.",
          "speechRecognitionPermission": "CoreOS utiliza el reconocimiento de voz para transcribir tus notas en el dispositivo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
