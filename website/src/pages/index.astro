---
import '../styles/global.css';

const repoUrl = 'https://github.com/EzequielMenor/CoreOS';
const domains = [
  {
    number: '01',
    name: 'Notes',
    description: 'Ideas, references, and free-form text, kept as you wrote them.',
    detail: 'Markdown · FTS5 search · tags',
    className: 'domain-notes',
  },
  {
    number: '02',
    name: 'Tasks',
    description: 'An intention becomes a task with a date and a priority.',
    detail: 'Natural dates · inline completion',
    className: 'domain-tasks',
  },
  {
    number: '03',
    name: 'Expenses',
    description: 'Expenses captured in the same place, without changing context.',
    detail: 'Amount · category · date',
    className: 'domain-expenses',
  },
  {
    number: '04',
    name: 'Habits',
    description: 'Small records that do not need a separate app.',
    detail: 'Daily log · status',
    className: 'domain-habits',
  },
  {
    number: '05',
    name: 'Sleep',
    description: 'Hours, quality, and rest are part of the system too.',
    detail: 'Hours · deep sleep · quality',
    className: 'domain-sleep',
  },
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="CoreOS is a local-first personal operating system. Capture first. Organize later." />
    <meta name="theme-color" content="#F6F2EA" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>CoreOS — Capture first. Organize later.</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('coreos-theme');
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = stored || (systemDark ? 'dark' : 'light');
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#top" aria-label="CoreOS home">
          <span class="brand-mark" aria-hidden="true"><span></span></span>
          <span>CoreOS</span>
        </a>

        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="#principle" data-nav-link>Principle</a>
          <a href="#flow" data-nav-link>How it works</a>
          <a href="#product" data-nav-link>Product</a>
          <a href="#privacy" data-nav-link>Local-first</a>
        </nav>

        <div class="header-actions">
          <button class="icon-button theme-toggle" type="button" data-theme-toggle data-theme="light" aria-label="Cambiar a modo oscuro">
            <span class="theme-icon theme-icon-sun" aria-hidden="true">☼</span>
            <span class="theme-icon theme-icon-moon" aria-hidden="true">◐</span>
          </button>
          <a class="header-cta" href={repoUrl} target="_blank" rel="noreferrer">View on GitHub <span aria-hidden="true">↗</span></a>
          <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir navegación">
            <span></span><span></span>
          </button>
        </div>
      </div>
      <nav class="mobile-menu" id="mobile-menu" data-mobile-menu aria-label="Mobile navigation">
        <a href="#principle" data-nav-link>Principle <span>01</span></a>
        <a href="#flow" data-nav-link>How it works <span>02</span></a>
        <a href="#product" data-nav-link>Product <span>03</span></a>
        <a href="#privacy" data-nav-link>Local-first <span>04</span></a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-copy reveal">
            <p class="eyebrow"><span class="eyebrow-line"></span> A personal operating system</p>
            <h1 id="hero-title">Capture first.<br /><em>Organize later.</em></h1>
            <p class="hero-lede">The quiet place for everything on your mind. Write freely. CoreOS keeps the original safe, then lets AI put it where it belongs.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#flow">See the principle <span aria-hidden="true">↓</span></a>
              <a class="text-link" href={repoUrl} target="_blank" rel="noreferrer">Explore the repository <span aria-hidden="true">↗</span></a>
            </div>
            <p class="hero-note"><span class="status-dot" aria-hidden="true"></span> Local-first by design · Personal V1</p>
          </div>

          <div class="hero-visual reveal reveal-delay-1" aria-label="A CoreOS capture being saved locally and classified later">
            <div class="visual-caption visual-caption-top"><span>01</span> The inbox starts here</div>
            <div class="capture-window">
              <div class="window-topbar">
                <span class="window-brand"><span class="mini-mark" aria-hidden="true"></span> Capturar</span>
                <span class="window-time">14:53</span>
              </div>
              <div class="window-body">
                <p class="window-label">Cualquier cosa</p>
                <p class="raw-capture">Tomorrow call the workshop to ask for an appointment<span class="cursor" aria-hidden="true"></span></p>
                <div class="save-row">
                  <span class="saved-label"><span class="check-mark" aria-hidden="true">✓</span> Saved locally</span>
                  <span class="saved-time">just now</span>
                </div>
              </div>
              <div class="window-footer"><span>Raw text stays canonical</span><span class="footer-lock" aria-label="Saved on device">⌂</span></div>
            </div>
            <div class="classification-line" aria-hidden="true"><span></span><i></i><span></span></div>
            <div class="route-note"><span class="route-icon" aria-hidden="true">↳</span><span><strong>Later, AI classifies it</strong><small>Tasks · Notes · Expenses · Habits · Sleep</small></span></div>
            <div class="visual-caption visual-caption-bottom"><span>02</span> Organization comes after capture</div>
          </div>
        </div>
        <div class="hero-rule" aria-hidden="true"></div>
      </section>

      <section class="intro-section section" id="principle" aria-labelledby="principle-title">
        <div class="container intro-grid">
          <p class="section-kicker reveal">The principle</p>
          <div class="intro-content reveal reveal-delay-1">
            <h2 id="principle-title">Most tools ask you to organize before they let you save.</h2>
            <p class="large-copy">That tiny decision is enough to make a thought disappear. CoreOS removes it. There is one place to put something down, and time to decide what it means later.</p>
            <div class="pull-quote"><span class="quote-mark" aria-hidden="true">“</span><p>Write the thing down. Keep the thing safe. Let the system do the sorting.</p></div>
          </div>
        </div>
      </section>

      <section class="flow-section section" id="flow" aria-labelledby="flow-title">
        <div class="container">
          <div class="section-heading reveal">
            <p class="section-kicker">The quiet machinery</p>
            <h2 id="flow-title">A simple order of operations.</h2>
            <p>CoreOS is deliberately boring in the best way: capture is immediate, organization is asynchronous, and your words are never rewritten to make the system look smarter.</p>
          </div>
          <ol class="flow-list">
            <li class="flow-item reveal">
              <span class="flow-number">01</span>
              <div class="flow-icon flow-icon-capture" aria-hidden="true"><span></span></div>
              <div class="flow-copy"><h3>Capture</h3><p>Type whatever is in your head. No folders, forms, or decisions required.</p></div>
              <span class="flow-aside">free-form text</span>
            </li>
            <li class="flow-item reveal reveal-delay-1">
              <span class="flow-number">02</span>
              <div class="flow-icon flow-icon-save" aria-hidden="true"><span>✓</span></div>
              <div class="flow-copy"><h3>Persist locally</h3><p>The raw capture lands in SQLite on your device before any AI call is made.</p></div>
              <span class="flow-aside">on-device first</span>
            </li>
            <li class="flow-item reveal reveal-delay-2">
              <span class="flow-number">03</span>
              <div class="flow-icon flow-icon-ai" aria-hidden="true"><span>✦</span></div>
              <div class="flow-copy"><h3>Classify with AI</h3><p>When the system is ready, a model suggests the domain and useful metadata.</p></div>
              <span class="flow-aside">retryable</span>
            </li>
            <li class="flow-item reveal reveal-delay-3">
              <span class="flow-number">04</span>
              <div class="flow-icon flow-icon-organize" aria-hidden="true"><span></span><span></span><span></span></div>
              <div class="flow-copy"><h3>Organize automatically</h3><p>Your original words arrive in Notes, Tasks, Expenses, Habits, or Sleep.</p></div>
              <span class="flow-aside">five domains</span>
            </li>
          </ol>
        </div>
      </section>

      <section class="product-section section" id="product" aria-labelledby="product-title">
        <div class="container">
          <div class="section-heading product-heading reveal">
            <p class="section-kicker">Inside CoreOS</p>
            <h2 id="product-title">A calmer interface for a noisier life.</h2>
            <p>Three places you return to: what needs attention, what you want to capture, and what you have kept.</p>
          </div>
          <div class="screens-grid">
            <figure class="screen-figure screen-figure-featured reveal">
              <div class="phone-frame"><img src="/product/today.png" alt="CoreOS Today screen showing a greeting and prioritized tasks" loading="lazy" /></div>
              <figcaption><span class="figure-number">01</span><span><strong>Today</strong><small>A small briefing for the things that matter now.</small></span></figcaption>
            </figure>
            <figure class="screen-figure reveal reveal-delay-1">
              <div class="phone-frame phone-frame-offset"><img src="/product/capture.png" alt="CoreOS Capture screen with a free-form text field and save button" loading="lazy" /></div>
              <figcaption><span class="figure-number">02</span><span><strong>Capture</strong><small>One field. Anything you want to remember.</small></span></figcaption>
            </figure>
            <figure class="screen-figure reveal reveal-delay-2">
              <div class="phone-frame"><img src="/product/library.png" alt="CoreOS Library screen with searchable, tagged notes" loading="lazy" /></div>
              <figcaption><span class="figure-number">03</span><span><strong>Library</strong><small>Find it again when the moment is right.</small></span></figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="domains-section section" id="dominios" aria-labelledby="domains-title">
        <div class="container domains-grid">
          <div class="domains-intro reveal">
            <p class="section-kicker">One inbox, many lives</p>
            <h2 id="domains-title">A place for the whole picture.</h2>
            <p>Notes are only the beginning. A single capture can become whatever kind of record it needs to be, without making you choose up front.</p>
          </div>
          <div class="domain-list" role="list">
            {domains.map((domain) => (
              <div class={`domain-row ${domain.className} reveal`} role="listitem">
                <span class="domain-number">{domain.number}</span>
                <span class="domain-name">{domain.name}</span>
                <span class="domain-description">{domain.description}</span>
                <span class="domain-detail">{domain.detail}</span>
                <span class="domain-arrow" aria-hidden="true">↗</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="privacy-section section" id="privacy" aria-labelledby="privacy-title">
        <div class="container privacy-panel">
          <div class="privacy-intro reveal">
            <p class="section-kicker">The local-first promise</p>
            <h2 id="privacy-title">Your second brain should not need a second account.</h2>
          </div>
          <div class="privacy-details reveal reveal-delay-1">
            <p class="large-copy">CoreOS is built for one person, on one device. The database lives locally. Your key lives in secure storage. If the model fails, your original capture is still there waiting.</p>
            <ul class="promise-list">
              <li><span class="promise-icon" aria-hidden="true">⌂</span><span><strong>SQLite on device</strong><small>Your data lives where you use it.</small></span></li>
              <li><span class="promise-icon" aria-hidden="true">—</span><span><strong>No backend. No account.</strong><small>No remote service sitting between you and your notes.</small></span></li>
              <li><span class="promise-icon" aria-hidden="true">✓</span><span><strong>Capture never gets lost</strong><small>AI can fail. The original text does not.</small></span></li>
            </ul>
          </div>
        </div>
      </section>

      <section class="closing-section section" aria-labelledby="closing-title">
        <div class="container closing-panel reveal">
          <div class="closing-mark" aria-hidden="true"><span></span><span></span><span></span></div>
          <p class="section-kicker">For the thoughts between the plans</p>
          <h2 id="closing-title">Make room to think.<br /><em>Let CoreOS remember.</em></h2>
          <a class="button button-light" href={repoUrl} target="_blank" rel="noreferrer">See CoreOS on GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="brand" href="#top" aria-label="CoreOS home"><span class="brand-mark" aria-hidden="true"><span></span></span><span>CoreOS</span></a>
        <p>Capture first. Organize later.</p>
        <div class="footer-links"><a href={repoUrl} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href="#privacy">Local-first</a><span>Personal V1 · 2026</span></div>
      </div>
    </footer>

    <script src="../scripts/site.ts"></script>
  </body>
</html>
